#!/bin/bash
# qbdisplay-helper – die einzigen Aktionen, die qbdisplay mit Root-Rechten ausführen darf
#
# Copyright (C) 2026  STRE – GNU GPLv3
#
# install.sh legt diese Datei root-eigen nach /usr/local/sbin und erlaubt dem
# qbdisplay-Benutzer per /etc/sudoers.d/qbdisplay genau diesen Befehl ohne Passwort.
#   version        QIDI-Firmwareversion ausgeben (/root/xindi/version ist nur für root lesbar)
#   to-qidi        zur QIDI-Oberfläche zurückwechseln (läuft im Hintergrund, ca. 7 min)
#   update <dir>   geprüftes, entpacktes Release aus ~/qbdisplay-updates installieren
#                  (läuft im Hintergrund; Ergebnis in qbdisplay-backup/update-status)
#   wifi-scan      WLAN-Netze in Reichweite (JSON)
#   wifi-status    aktuelle WLAN-Verbindung (JSON)
#   wifi-connect   Netz ausprobieren und nur bei Erfolg speichern; SSID und Passwort
#                  kommen zeilenweise über stdin (nie als Argument, sonst stünden sie
#                  in der Prozessliste und im sudo-Protokoll)
set -u

BACKUP="@BACKUP@"
APPDIR="@APPDIR@"
APPUSER="@USER@"
QIDI_TFT="$BACKUP/800_480-qidi.tft"
UPDATES="$(dirname "$APPDIR")/qbdisplay-updates"
STATUS="$BACKUP/update-status"
TFT_SUM="$BACKUP/installed-tft.sha256"
TFT_TARGET="/root/800_480.tft"
API="http://127.0.0.1:7125"
SELF="/usr/local/sbin/qbdisplay-helper"

wake_display() {
  python3 - <<'PY' || true
import os, termios, time
fd = os.open('/dev/ttyS1', os.O_RDWR | os.O_NOCTTY | os.O_NONBLOCK)
a = termios.tcgetattr(fd)
a[0] = a[1] = a[3] = 0
a[2] = termios.CS8 | termios.CREAD | termios.CLOCAL
a[4] = a[5] = termios.B115200
termios.tcsetattr(fd, termios.TCSANOW, a)
for cmd in (b'sleep=0', b'thsp=0'):
    os.write(fd, cmd + b'\xff\xff\xff')
    time.sleep(0.3)
os.close(fd)
PY
}

# Display-Datei über QIDIs eigenen Mechanismus aufspielen (makerbase-client flasht
# /root/800_480.tft beim Start und löscht sie danach). qbdisplay muss gestoppt sein.
flash_tft() {
  wake_display
  cp "$1" "$TFT_TARGET" || return 1
  sync
  systemctl restart makerbase-client
  for _ in $(seq 1 90); do
    [ -e "$TFT_TARGET" ] || break
    sleep 10
  done
  systemctl stop makerbase-client
  [ ! -e "$TFT_TARGET" ]
}

status() {   # status <zustand> <text>
  printf 'state=%s\nfrom=%s\nto=%s\ntime=%s\nmessage=%s\n' "$1" "${FROM:-}" "${TO:-}" \
    "$(date +%s)" "$2" > "$STATUS.tmp"
  chown "$APPUSER": "$STATUS.tmp"
  mv "$STATUS.tmp" "$STATUS"
}

pkg_version() {
  sed -n 's/^__version__ *= *["'\'']\([^"'\'']*\)["'\''].*/\1/p' "$1/qbdisplay/__init__.py" 2>/dev/null
}

printer_busy() {
  curl -s "$API/printer/objects/query?print_stats=state" | grep -q '"printing"\|"paused"'
}

# Paket prüfen (läuft vor dem Start im Vordergrund, damit qbdisplay Fehler sofort sieht)
check_update() {
  local new="$1" real
  real="$(readlink -f "$new")" || { echo "Ordner fehlt"; return 1; }
  case "$real" in
    "$UPDATES"/qbdisplay-plus4-*) ;;
    *) echo "Ordner nicht unter $UPDATES"; return 1 ;;
  esac
  [ "$(stat -c %U "$real")" = "$APPUSER" ] || { echo "Ordner gehört nicht $APPUSER"; return 1; }
  for f in install.sh qbdisplay.tft qbdisplay/__init__.py systemd/qbdisplay-helper \
           systemd/qbdisplay.service; do
    [ -f "$real/$f" ] || { echo "$f fehlt im Paket"; return 1; }
  done
  [ -n "$(pkg_version "$real")" ] || { echo "Version im Paket fehlt"; return 1; }
  # Hilfsskript und Dienst werden nie automatisch ersetzt (sonst root ohne Passwort)
  local a='@'   # Platzhalter zusammensetzen, sonst ersetzt install.sh sie hier mit
  if ! sed "s#${a}BACKUP${a}#$BACKUP#; s#${a}APPDIR${a}#$APPDIR#; s#${a}USER${a}#$APPUSER#" \
        "$real/systemd/qbdisplay-helper" | cmp -s - "$SELF"; then
    echo "manual: neues Hilfsskript - bitte ./install.sh von Hand ausführen"; return 3
  fi
  if ! cmp -s "$real/systemd/qbdisplay.service" "$APPDIR/systemd/qbdisplay.service"; then
    echo "manual: geänderter Dienst - bitte ./install.sh von Hand ausführen"; return 3
  fi
  printer_busy && { echo "Es läuft ein Druck"; return 1; }
  return 0
}

run_update() {
  local new old tft_flashed=0 sum
  new="$(readlink -f "$1")"
  FROM="$(pkg_version "$APPDIR")"
  TO="$(pkg_version "$new")"
  old="$APPDIR-alt-$FROM"
  status running "Installation läuft"

  systemctl stop qbdisplay
  rm -rf "$old"
  mv "$APPDIR" "$old" || { systemctl start qbdisplay; status failed "Ordner nicht tauschbar"; return 1; }
  mv "$new" "$APPDIR" || { mv "$old" "$APPDIR"; systemctl start qbdisplay
                           status failed "Ordner nicht tauschbar"; return 1; }
  chown -R "$APPUSER": "$APPDIR"
  sudo -u "$APPUSER" python3 -m compileall -q "$APPDIR/qbdisplay" >/dev/null 2>&1

  sum="$(sha256sum "$APPDIR/qbdisplay.tft" | cut -d' ' -f1)"
  if [ "$sum" != "$(cat "$TFT_SUM" 2>/dev/null)" ]; then
    status running "Display-Datei wird aufgespielt (ca. 2 min)"
    if flash_tft "$APPDIR/qbdisplay.tft"; then
      echo "$sum" > "$TFT_SUM"
      tft_flashed=1
    else
      rollback "$old" 0 "Display-Datei ließ sich nicht aufspielen"
      return 1
    fi
  fi

  systemctl start qbdisplay
  sleep 15
  if systemctl is-active --quiet qbdisplay; then
    status done "qbdisplay $TO installiert"
    return 0
  fi
  rollback "$old" "$tft_flashed" "qbdisplay $TO startet nicht"
  return 1
}

rollback() {   # rollback <alter ordner> <tft neu aufgespielt?> <grund>
  local old="$1" flashed="$2" why="$3"
  systemctl stop qbdisplay
  rm -rf "$APPDIR.failed"
  mv "$APPDIR" "$APPDIR.failed"
  mv "$old" "$APPDIR"
  if [ "$flashed" = 1 ] && flash_tft "$APPDIR/qbdisplay.tft"; then
    sha256sum "$APPDIR/qbdisplay.tft" | cut -d' ' -f1 > "$TFT_SUM"
  fi
  systemctl start qbdisplay
  status failed "$why"
}

# --- WLAN ---------------------------------------------------------------------------
# Spricht direkt mit dem Steuer-Socket von wpa_supplicant (wie wpa_cli), damit SSID und
# Passwort nie auf einer Befehlszeile landen. SSID und Schlüssel gehen hexkodiert an
# wpa_supplicant – keine Anführungszeichen, nichts zu escapen.
# Zwischen den Markierungen steht reines Python (tests/test_helper_wifi.py lädt es).
read -r -d '' WIFI_PY <<'PY'
# --- WIFI_PY BEGIN ---
import hashlib
import json
import os
import re
import shutil
import socket
import sys
import tempfile
import time

CTRL = '/var/run/wpa_supplicant/wlan0'
CONNECT_TIMEOUT = 35      # bis wpa_supplicant verbunden ist
DHCP_TIMEOUT = 30         # danach bis eine IP-Adresse da ist


class Ctrl(object):
    """Steuer-Socket von wpa_supplicant: Befehl senden, Antwort lesen."""

    def __init__(self, path=CTRL):
        self.dir = tempfile.mkdtemp(prefix='qbdisplay-wpa-')
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
        self.sock.bind(os.path.join(self.dir, 'sock'))
        self.sock.connect(path)
        self.sock.settimeout(10)

    def __call__(self, cmd):
        self.sock.send(cmd.encode('utf-8'))
        while True:
            data = self.sock.recv(65536).decode('utf-8', 'replace')
            if not data.startswith('<'):     # "<3>CTRL-EVENT-..." sind Ereignisse
                return data.strip()

    def close(self):
        self.sock.close()
        shutil.rmtree(self.dir, True)


def unescape(s):
    """SSID aus scan_results/list_networks (printf-kodiert: \\xNN, \\\\, \\") -> bytes."""
    out = bytearray()
    i = 0
    while i < len(s):
        ch = s[i]
        if ch == '\\' and i + 1 < len(s):
            nxt = s[i + 1]
            if nxt == 'x' and i + 3 < len(s):
                try:
                    out.append(int(s[i + 2:i + 4], 16))
                    i += 4
                    continue
                except ValueError:
                    pass
            out.extend({'n': b'\n', 'r': b'\r', 't': b'\t', 'e': b'\x1b'}.get(
                nxt, nxt.encode('utf-8')))
            i += 2
            continue
        out.extend(ch.encode('utf-8'))
        i += 1
    return bytes(out)


def ssid_text(raw):
    return raw.decode('utf-8', 'replace')


def kv(text):
    res = {}
    for line in text.splitlines():
        if '=' in line:
            k, v = line.split('=', 1)
            res[k] = v
    return res


def status(ctl):
    st = kv(ctl('STATUS'))
    return {'state': st.get('wpa_state', ''),
            'ssid': ssid_text(unescape(st.get('ssid', ''))) if st.get('ssid') else '',
            'ip': st.get('ip_address', ''), 'id': st.get('id')}


def scan(ctl, wait=4.0):
    ctl('SCAN')                 # FAIL-BUSY: es läuft schon eine Suche – Ergebnisse kommen trotzdem
    time.sleep(wait)
    best = {}
    for line in ctl('SCAN_RESULTS').splitlines()[1:]:
        parts = line.split('\t')
        if len(parts) < 5:
            continue
        _bssid, freq, level, flags, name = parts[:5]
        raw = unescape(name)
        if not raw or raw.strip(b'\x00') == b'':
            continue            # verstecktes Netz
        try:
            level, freq = int(level), int(freq)
        except ValueError:
            continue
        secure = any(k in flags for k in ('WPA', 'RSN', 'WEP', 'SAE'))
        if 'WEP' in flags and not any(k in flags for k in ('WPA', 'RSN')):
            kind = 'wep'
        elif 'SAE' in flags and 'PSK' not in flags:
            kind = 'sae'        # nur WPA3 – kann dieser Stick meist nicht
        elif 'EAP' in flags and 'PSK' not in flags:
            kind = 'eap'        # Firmen-WLAN mit Benutzerkonto
        else:
            kind = 'psk' if secure else 'open'
        cur = best.get(raw)
        if cur is None or level > cur['signal']:
            best[raw] = {'ssid': ssid_text(raw), 'signal': level, 'freq': freq, 'kind': kind}
    current = status(ctl).get('ssid')
    nets = sorted(best.values(), key=lambda n: -n['signal'])
    for n in nets:
        n['current'] = n['ssid'] == current
    return nets


def networks(ctl):
    """Gespeicherte Netze: [(id, ssid-bytes, flags)]"""
    res = []
    for line in ctl('LIST_NETWORKS').splitlines()[1:]:
        parts = line.split('\t')
        if len(parts) >= 2:
            res.append((parts[0], unescape(parts[1]), parts[3] if len(parts) > 3 else ''))
    return res


def check_input(ssid, psk):
    raw = ssid.encode('utf-8')
    if not 1 <= len(raw) <= 32:
        return 'SSID ungültig'
    if psk and not (8 <= len(psk) <= 63 and all(32 <= ord(c) <= 126 for c in psk)) \
            and not re.match(r'^[0-9a-fA-F]{64}$', psk):
        return 'Passwort muss 8 bis 63 Zeichen lang sein'
    return None


def psk_hex(ssid_raw, psk):
    if len(psk) == 64:
        return psk.lower()
    return hashlib.pbkdf2_hmac('sha1', psk.encode('ascii'), ssid_raw, 4096, 32).hex()


def ok(res):
    if res != 'OK':
        raise RuntimeError(res)


def connect(ctl, ssid, psk, sleep=time.sleep, clock=time.time):
    """Neues Netz ausprobieren. Klappt es nicht, wird es wieder entfernt und das alte
    WLAN wieder aufgenommen; gespeichert wird nur bei Erfolg."""
    err = check_input(ssid, psk)
    if err:
        return {'ok': False, 'reason': 'input', 'message': err}
    raw = ssid.encode('utf-8')
    before = networks(ctl)
    nid = ctl('ADD_NETWORK')
    if not nid.isdigit():
        return {'ok': False, 'reason': 'error', 'message': nid}
    try:
        ok(ctl('SET_NETWORK %s ssid %s' % (nid, raw.hex())))
        if psk:
            ok(ctl('SET_NETWORK %s psk %s' % (nid, psk_hex(raw, psk))))
        else:
            ok(ctl('SET_NETWORK %s key_mgmt NONE' % nid))
        ok(ctl('SET_NETWORK %s scan_ssid 1' % nid))
        ok(ctl('SELECT_NETWORK %s' % nid))
    except Exception as e:      # noqa
        ctl('REMOVE_NETWORK %s' % nid)
        restore(ctl, before)
        return {'ok': False, 'reason': 'error', 'message': str(e)}
    end = clock() + CONNECT_TIMEOUT
    seen = set()
    st = {}
    while clock() < end:
        st = status(ctl)
        seen.add(st['state'])
        if st['state'] == 'COMPLETED' and st['id'] == nid:
            break
        sleep(1)
    else:
        ctl('REMOVE_NETWORK %s' % nid)
        restore(ctl, before)
        reason = 'auth' if seen & {'4WAY_HANDSHAKE', 'GROUP_HANDSHAKE'} else 'notfound'
        return {'ok': False, 'reason': reason}
    end = clock() + DHCP_TIMEOUT
    while not st.get('ip') and clock() < end:
        sleep(1)
        st = status(ctl)
    if not st.get('ip'):
        ctl('REMOVE_NETWORK %s' % nid)
        restore(ctl, before)
        return {'ok': False, 'reason': 'dhcp'}
    # Erfolg: gleichnamige alte Einträge ersetzen, übrige wieder zulassen, speichern
    for oid, oraw, _flags in before:
        if oraw == raw:
            ctl('REMOVE_NETWORK %s' % oid)
    for oid, oraw, flags in before:
        if oraw != raw and '[DISABLED]' not in flags:
            ctl('ENABLE_NETWORK %s' % oid)
    ctl('SET_NETWORK %s priority 10' % nid)
    saved = ctl('SAVE_CONFIG') == 'OK'
    return {'ok': True, 'ssid': ssid, 'ip': st['ip'], 'saved': saved}


def restore(ctl, before):
    for oid, _raw, flags in before:
        if '[DISABLED]' not in flags:
            ctl('ENABLE_NETWORK %s' % oid)
    ctl('REASSOCIATE')


def main(argv, stdin=sys.stdin):
    ctl = Ctrl()
    try:
        if argv[0] == 'scan':
            res = scan(ctl)
        elif argv[0] == 'status':
            res = status(ctl)
        elif argv[0] == 'connect':
            ssid = stdin.readline().rstrip('\n')
            psk = stdin.readline().rstrip('\n')
            res = connect(ctl, ssid, psk)
        else:
            return 2
    finally:
        ctl.close()
    print(json.dumps(res))
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
# --- WIFI_PY END ---
PY

wifi() {   # wifi scan|status|connect
  python3 -c "$WIFI_PY" "$1"
}

case "${1:-}" in
  version)
    cat /root/xindi/version
    ;;
  to-qidi)
    [ -f "$QIDI_TFT" ] || { echo "QIDI-Display-Datei fehlt: $QIDI_TFT" >&2; exit 1; }
    # eigene Unit, damit der Wechsel weiterläuft, wenn qbdisplay gleich beendet wird
    systemd-run --unit=qbdisplay-to-qidi --collect "$0" to-qidi-run
    ;;
  to-qidi-run)
    systemctl disable --now qbdisplay
    rm -f "$TFT_SUM"      # danach ist QIDIs Display-Datei drauf
    wake_display
    cp "$QIDI_TFT" "$TFT_TARGET"
    sync
    systemctl enable makerbase-client
    systemctl restart makerbase-client
    ;;
  update)
    out="$(check_update "${2:-}")"; rc=$?
    echo "$out"
    [ $rc -eq 0 ] || exit $rc
    # eigene Unit: läuft weiter, wenn qbdisplay gleich beendet wird
    systemd-run --unit=qbdisplay-update --collect "$0" update-run "$2"
    ;;
  update-run)
    out="$(check_update "${2:-}")" || { FROM="$(pkg_version "$APPDIR")"; status failed "$out"; exit 1; }
    run_update "$2"
    ;;
  wifi-scan)
    wifi scan
    ;;
  wifi-status)
    wifi status
    ;;
  wifi-connect)
    # während eines Drucks nie das Netz wechseln (Verbindung bricht kurz ab)
    printer_busy && { echo '{"ok": false, "reason": "busy"}'; exit 1; }
    wifi connect
    ;;
  *)
    echo "Aufruf: $0 version|to-qidi|update <ordner>|wifi-scan|wifi-status|wifi-connect" >&2
    exit 2
    ;;
esac
